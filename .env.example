# AdultingOS environment template. Copy per app; never commit real values.
# Mobile (public, bundled):        apps/mobile/.env.example
# Admin portal (public, bundled):  apps/admin/.env.example
# Edge Functions (SECRET, server): supabase/functions/.env.example
# Public site (public):            apps/web-public/dist/config.example.js
#
# Signing secrets for release builds live only in CI secrets or ~/.gradle/gradle.properties:
# ADULTINGOS_UPLOAD_STORE_FILE= ADULTINGOS_UPLOAD_STORE_PASSWORD= ADULTINGOS_UPLOAD_KEY_ALIAS= ADULTINGOS_UPLOAD_KEY_PASSWORD=
